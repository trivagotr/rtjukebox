NODE_ENV=development
PORT=3000

# Local host connection. Docker Compose overrides these URLs for its app container.
DATABASE_URL=postgresql://radiotedu:radiotedu_local@localhost:5433/radiotedu?schema=public
REDIS_URL=redis://localhost:6379

# Replace these local placeholders before using a shared or deployed environment.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters

# Comma-separated browser origin allowlist.
CORS_ORIGINS=http://localhost:5173

POSTGRES_USER=radiotedu
POSTGRES_PASSWORD=radiotedu_local
POSTGRES_DB=radiotedu
POSTGRES_PORT=5434
REDIS_PORT=6380
HOST_PORT=3100
