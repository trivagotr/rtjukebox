NODE_ENV=development
PORT=3000

# Local host connection. Docker Compose overrides these URLs for its app container.
DATABASE_URL=postgresql://radiotedu:radiotedu_local@localhost:5433/radiotedu?schema=public
REDIS_URL=redis://localhost:6379

# Replace these local placeholders before using a shared or deployed environment.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
HEALTHCHECK_TOKEN=replace_with_a_random_healthcheck_token_of_at_least_32_chars
JWT_ISSUER=radiotedu-api
JWT_AUDIENCE=radiotedu-client
JWT_ALLOW_LEGACY_TOKENS=false
PUBLIC_BASE_PATH=/jukebox
RADIO_STREAM_URL=https://stream.radiotedu.com/live
UPLOAD_DIRECTORY=./uploads
FFPROBE_PATH=ffprobe
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# Required before Spotify secrets/tokens are stored in the database.
SPOTIFY_ENCRYPTION_KEY=

# Comma-separated browser origin allowlist.
CORS_ORIGINS=http://localhost:5173

POSTGRES_USER=radiotedu
POSTGRES_PASSWORD=radiotedu_local
POSTGRES_DB=radiotedu
POSTGRES_PORT=5434
REDIS_PORT=6380
HOST_PORT=3100
